# --- App ---
APP_ENV=development                 # development | production
APP_NAME=Deflake
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
PUBLIC_BASE_URL=http://localhost:5173
# Comma-separated exact origins. No wildcards.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Auth ---
SIGNUP_ENABLED=true
PASSWORD_MIN_LENGTH=8
OWNER_NAME=Workspace Owner
OWNER_PASSWORD=Owner2026
OWNER_EMAIL=owner@deflake.local            # Owner account, created by scripts/create_owner.py
JWT_SECRET=dev_only_jwt_secret_change_me_7f3a9c2e1b8d4f60                        # dev default; refused when APP_ENV=production
JWT_TTL_MINUTES=480
COOKIE_SECURE=false                 # localhost runs over http; true only behind HTTPS
DEMO_ACCOUNT_PASSWORD=Judge2026
DEMO_ACCOUNT_EMAIL=judge@deflake.local           # Member account listed in the Devpost testing notes

# --- Database ---
DB_HOST=mysql
DB_PORT=3306
DB_NAME=deflake
DB_USER=deflake_app                # least-privilege runtime user, never root
DB_PASSWORD=deflake_app_dev_pw
DB_MIGRATION_USER=deflake_migrator # DDL rights, used only by Alembic
DB_MIGRATION_PASSWORD=deflake_migrator_dev_pw
MYSQL_ROOT_PASSWORD=deflake_root_dev_pw   # read by Compose for first-time setup only
DB_POOL_SIZE=10
DB_POOL_RECYCLE_S=280              # below MySQL wait_timeout
DB_CHARSET=utf8mb4
CHECKPOINT_TABLE_PREFIX=lg_        # LangGraph checkpoint tables, same database

# --- AI provider ---
# nebius_token_factory | nvidia_nim | openai_compatible | anthropic | fake
AI_PROVIDER=nebius_token_factory

# U1: from Token Factory docs
AI_BASE_URL=
AI_API_KEY=

AI_MODEL_FAST=                # Nemotron Nano model ID (U1)
AI_MODEL_BALANCED=            # Nemotron Super model ID (U1)
AI_MODEL_REASONING=           # Nemotron Ultra model ID (U1)
AI_STRUCTURED_OUTPUT_METHOD=json_schema   # json_schema | json_mode | parse
AI_TEMPERATURE_DEFAULT=0.2
AI_TEMPERATURE_SELF_CONSISTENCY=0.7
AI_REQUEST_TIMEOUT_S=90
AI_MAX_RETRIES=3
AI_RUN_BUDGET_USD=2.00             # hard stop per run
AI_PRICE_FAST_IN_PER_MTOK=
AI_PRICE_FAST_OUT_PER_MTOK=
AI_PRICE_BALANCED_IN_PER_MTOK=
AI_PRICE_BALANCED_OUT_PER_MTOK=
AI_PRICE_REASONING_IN_PER_MTOK=
AI_PRICE_REASONING_OUT_PER_MTOK=

# --- Tavily ---
TAVILY_ENABLED=true
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=basic          # basic | advanced

# --- Escalation (Tendem, with fallback) ---
# tendem | github_issue | local
ESCALATION_PROVIDER=tendem
# github_issue | local
ESCALATION_FALLBACK=local
TENDEM_API_KEY=
# No public REST API. Leave this blank.
TENDEM_BASE_URL=
# Hosted MCP. Blank uses https://mcp.tendem.ai/mcp
TENDEM_MCP_URL=
# optional, fine-grained, issues:write on one repo
GITHUB_TOKEN=
# owner/name
GITHUB_REPO=

# --- GitHub repository import ---
# true | false — public URL import on the Repositories page
GITHUB_IMPORT_ENABLED=true
# optional; raises the public metadata rate limit only
GITHUB_PUBLIC_TOKEN=
# true | false — Connect GitHub for private repos and pull requests
GITHUB_OAUTH_ENABLED=false
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/github/oauth/callback
GITHUB_OAUTH_SCOPES=repo read:user
GITHUB_OAUTH_SUCCESS_URL=http://localhost:5173/settings/integration
# Fernet key; generate with: make keys
GITHUB_TOKEN_ENCRYPTION_KEY=As27ncx98MWLTE0VPMuy34wqXVHOuv_AXC7z51GRrN4=
PREPARER_URL=http://preparer:8200
PREPARER_SHARED_SECRET=dev_only_preparer_secret_change_me_9c2d41aa
REPO_MAX_SIZE_MB=200
REPO_CLONE_TIMEOUT_S=120
PREPARE_TIMEOUT_S=600
MAX_IMPORTED_REPOS_PER_USER=10

# --- Audit (Toloka, with CSV fallback) ---
# toloka | csv_import
AUDIT_PROVIDER=toloka
TOLOKA_API_KEY=
# sandbox | production
TOLOKA_ENV=sandbox
# Documented Pipeline API. Blank uses https://platform.toloka.ai
TOLOKA_BASE_URL=
# Pipeline designed in the Toloka app. Blank keeps labels on the CSV import.
TOLOKA_PIPELINE_ID=
# Reviewers per item
TOLOKA_OVERLAP=3
CALIBRATION_MIN_LABELS=30

# --- LangSmith ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deflake
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Runner ---
RUNNER_URL=http://runner:8100
RUNNER_SHARED_SECRET=dev_only_runner_secret_change_me_4e91b07d              # dev default; the runner reads the same value
DETECT_RERUNS=30
VERIFY_RERUNS=200
VERIFY_RERUNS_MAX=600
PER_TEST_RUN_TIMEOUT_S=60
RUN_TIME_BUDGET_MIN=25
MAX_CONCURRENT_RUNS=2
MAX_PATCH_ATTEMPTS=3
MAX_DIAGNOSE_RETRIES=2
SELF_CONSISTENCY_SAMPLES=3
CONFIDENCE_THRESHOLD_DEFAULT=0.80
ALLOWLIST_PATH=../demo-repos/allowlist.yaml
LOG_MAX_CHARS=8000                 # head + tail kept per log

# --- Runner-only (read by the runner container, which receives no other keys) ---
RUNNER_WORKDIR=/work
RUNNER_MAX_PARALLEL=4
RUNNER_MEM_LIMIT_MB=1024
RUNNER_CPU_SECONDS=120
RUNNER_REPOS_DIR=/repos
